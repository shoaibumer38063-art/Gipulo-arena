{
  "name": "gipulo-shell",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Gipulo shell — DOM/UI only (TS/React). Never editor logic: engine-core.md §1.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
